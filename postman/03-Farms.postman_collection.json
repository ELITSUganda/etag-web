			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/farms/{{farm_id}}?administrator_id={{administrator_id}}",
					"host": ["{{base_url}}"],
					"path": ["farms", "{{farm_id}}"],
					"query": [
						{
							"key": "administrator_id",
