{
	"info": {
		"_postman_id": "auth-collection-001",
		"name": "01 - Authentication & User Management",
		"description": "All authentication and user management endpoints including login, registration, profile updates, and role management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data && jsonData.data.token) {",
							"        pm.environment.set('token', jsonData.data.token);",
							"        pm.environment.set('user_id', jsonData.data.id);",
							"        pm.environment.set('administrator_id', jsonData.data.id);",
							"        console.log('Token saved:', jsonData.data.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phone_number\": \"{{phone_number}}\",\n    \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/login",
					"host": ["{{base_url}}"],
					"path": ["login"]
				},
				"description": "Login with phone number and password. On success, token is automatically saved to environment."
			},
			"response": []
		},
		{
			"name": "Create Account",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"John Doe\",\n    \"phone_number\": \"0700000000\",\n    \"password\": \"12345678\",\n    \"phone_number_2\": \"\",\n    \"address\": \"Kampala\",\n    \"email\": \"johndoe@example.com\",\n    \"nin\": \"CM1234567890ABC\",\n    \"user_type\": \"Farmer\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/login/create-account",
					"host": ["{{base_url}}"],
					"path": ["login", "create-account"]
				},
				"description": "Create a new user account. user_type can be: Farmer, Trader, etc."
			},
			"response": []
		},
		{
			"name": "Get User Profile (Me)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/me?administrator_id={{administrator_id}}",
					"host": ["{{base_url}}"],
					"path": ["me"],
					"query": [
						{
							"key": "administrator_id",
							"value": "{{administrator_id}}"
						}
					]
				},
				"description": "Get current user profile information"
			},
			"response": []
		},
		{
			"name": "Users Me (Alternative)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/users/me?administrator_id={{administrator_id}}",
					"host": ["{{base_url}}"],
					"path": ["users", "me"],
					"query": [
						{
							"key": "administrator_id",
							"value": "{{administrator_id}}"
						}
					]
				},
				"description": "Alternative endpoint to get user profile"
			},
			"response": []
		},
