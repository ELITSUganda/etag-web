						}
					]
				},
				"description": "Get detailed information about a specific farm"
			},
			"response": []
		},
		{
			"name": "Create Farm",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data && jsonData.data.id) {",
							"        pm.environment.set('farm_id', jsonData.data.id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"administrator_id\": \"{{administrator_id}}\",\n    \"name\": \"Green Valley Farm\",\n    \"size\": \"50 Acres\",\n    \"location_id\": \"1\",\n    \"sub_county_id\": \"1\",\n    \"parish_id\": \"1\",\n    \"village\": \"Nakasongola\",\n    \"address\": \"Plot 123, Main Road\",\n    \"holding_code\": \"UG-FRM-001\",\n    \"latitude\": \"0.3476\",\n    \"longitude\": \"32.5825\",\n    \"details\": \"Mixed farming with cattle and crops\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/farms",
					"host": ["{{base_url}}"],
					"path": ["farms"]
				},
				"description": "Create a new farm. Farm ID is saved to environment on success."
			},
			"response": []
		},
