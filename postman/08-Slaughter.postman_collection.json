			"name": "Create Slaughter Distribution Record",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"administrator_id\": \"{{administrator_id}}\",\n    \"slaughter_record_id\": \"1\",\n    \"buyer_name\": \"ABC Butchery\",\n    \"buyer_phone\": \"0700000006\",\n    \"buyer_address\": \"Kampala\",\n    \"meat_weight\": \"50\",\n    \"price_per_kg\": 15000,\n    \"total_amount\": 750000,\n    \"distribution_date\": \"2025-11-10\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/create-slaughter-distribution-record",
					"host": ["{{base_url}}"],
					"path": ["create-slaughter-distribution-record"]
				},
				"description": "Create a meat distribution record"
			},
			"response": []
		},
		{
			"name": "Slaughter Session",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"administrator_id\": \"{{administrator_id}}\",\n    \"slaughter_house_id\": \"1\",\n    \"session_date\": \"2025-11-10\",\n    \"session_type\": \"Morning\",\n    \"inspector_id\": \"2\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/slaughter-session",
