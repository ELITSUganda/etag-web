{
	"info": {
		"_postman_id": "vaccination-collection-007",
		"name": "07 - Vaccination Management",
		"description": "Vaccination programs, schedules, orders, district vaccine stocks, and vaccination records.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Vaccination Programs",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/vaccination-programs?administrator_id={{administrator_id}}",
					"host": ["{{base_url}}"],
					"path": ["vaccination-programs"],
					"query": [
						{
							"key": "administrator_id",
							"value": "{{administrator_id}}"
						}
					]
				},
				"description": "Get list of vaccination programs"
			},
			"response": []
		},
		{
			"name": "Create Vaccination Program",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"administrator_id\": \"{{administrator_id}}\",\n    \"name\": \"FMD Vaccination Campaign 2025\",\n    \"disease\": \"Foot and Mouth Disease\",\n    \"vaccine_name\": \"FMD Vaccine\",\n    \"start_date\": \"2025-12-01\",\n    \"end_date\": \"2025-12-31\",\n    \"target_animals\": 1000,\n    \"description\": \"Annual FMD vaccination\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/create-vaccination-programs",
					"host": ["{{base_url}}"],
					"path": ["create-vaccination-programs"]
				},
				"description": "Create a new vaccination program"
			},
			"response": []
		},
