		{
			"name": "Get Farms List",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/farms?administrator_id={{administrator_id}}",
					"host": ["{{base_url}}"],
					"path": ["farms"],
					"query": [
						{
							"key": "administrator_id",
							"value": "{{administrator_id}}"
						}
					]
				},
				"description": "Get list of all farms for the authenticated user"
			},
			"response": []
		},
