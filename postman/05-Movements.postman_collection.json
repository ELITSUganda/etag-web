		{
			"name": "Get Movements List",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/movements?administrator_id={{administrator_id}}",
					"host": ["{{base_url}}"],
					"path": ["movements"],
					"query": [
						{
							"key": "administrator_id",
							"value": "{{administrator_id}}"
						}
					]
				},
				"description": "Get list of all movement permits"
			},
			"response": []
		},
