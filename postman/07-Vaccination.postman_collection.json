				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"administrator_id\": \"{{administrator_id}}\",\n    \"order_id\": \"1\",\n    \"phone_number\": \"{{phone_number}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/vaccination-product-order-payment-link-create",
