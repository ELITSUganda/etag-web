		{
			"name": "Create Animal",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data && jsonData.data.id) {",
							"        pm.environment.set('animal_id', jsonData.data.id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"administrator_id\": \"{{administrator_id}}\",\n    \"type\": \"Cattle\",\n    \"e_id\": \"UG001234567890\",\n    \"v_id\": \"VID123456\",\n    \"lhc\": \"LHC001\",\n    \"breed\": \"Ankole\",\n    \"sex\": \"Male\",\n    \"dob\": \"2020-01-15\",\n    \"color\": \"Brown\",\n    \"farm_id\": \"{{farm_id}}\",\n    \"details\": \"Healthy animal\",\n    \"status\": \"Active\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/animals",
					"host": ["{{base_url}}"],
					"path": ["animals"]
				},
				"description": "Create a new animal record. Animal ID is saved to environment on success."
			},
			"response": []
		},
